<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Cokeboys Macro Builder</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Russo+One&family=Inter:wght@400;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#07080f;--glass:rgba(22,26,42,.62);--glass2:rgba(30,35,56,.75);--line:rgba(255,255,255,.08);--line2:rgba(255,255,255,.16);
  --text:#eef1ff;--mute:#8d95b8;--y:#ffd21f;--y2:#ff9f1c;--danger:#ff4d6d;--ok:#2ef2a0;
  --fruit:#b66bff;--melee:#ff8a3d;--sword:#3fb6ff;--gun:#2ef2a0;
  --mono:"JetBrains Mono",ui-monospace,Consolas,monospace;
}
*{box-sizing:border-box}
html,body{margin:0}
body{background:var(--bg);color:var(--text);font:14px/1.45 Inter,system-ui,"Segoe UI",sans-serif;min-height:100vh;overflow-x:hidden}
/* animated background */
.bg{position:fixed;inset:0;z-index:-1;overflow:hidden;pointer-events:none}
.bg::before{content:"";position:absolute;inset:-50%;background:
  radial-gradient(closest-side,rgba(255,210,31,.18),transparent 70%) 20% 10%/50% 50% no-repeat,
  radial-gradient(closest-side,rgba(182,107,255,.20),transparent 70%) 85% 20%/55% 55% no-repeat,
  radial-gradient(closest-side,rgba(63,182,255,.14),transparent 70%) 50% 95%/60% 50% no-repeat;
  animation:drift 22s ease-in-out infinite alternate}
.bg::after{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px);background-size:40px 40px;mask-image:radial-gradient(ellipse at 50% 0,#000 30%,transparent 75%)}
@keyframes drift{to{transform:translate(4%,3%) rotate(6deg)}}
@media (prefers-reduced-motion:reduce){.bg::before{animation:none}}

header{max-width:1320px;margin:0 auto;padding:22px 20px 10px;display:flex;align-items:center;gap:16px;flex-wrap:wrap}
.logo{width:62px;height:62px;flex:none;filter:drop-shadow(0 0 18px rgba(255,210,31,.55));animation:bob 3.2s ease-in-out infinite}
@keyframes bob{50%{transform:translateY(-4px) rotate(-3deg)}}
.brand{flex:1;min-width:220px}
h1{margin:0;font:400 30px/1.05 "Russo One",Inter,sans-serif;letter-spacing:.5px;
  background:linear-gradient(90deg,#fff 0%,var(--y) 45%,var(--y2) 70%,#fff 100%);background-size:200% auto;-webkit-background-clip:text;background-clip:text;color:transparent;animation:shine 6s linear infinite}
@keyframes shine{to{background-position:200% center}}
.brand p{margin:4px 0 0;color:var(--mute);font-size:13px}
.discord{display:inline-flex;align-items:center;gap:10px;padding:11px 18px;border-radius:14px;background:linear-gradient(135deg,#5865f2,#7983ff);color:#fff;font-weight:800;text-decoration:none;box-shadow:0 8px 28px rgba(88,101,242,.45),inset 0 1px 0 rgba(255,255,255,.25);transition:.15s}
.discord:hover{transform:translateY(-2px);box-shadow:0 12px 34px rgba(88,101,242,.6)}
.discord svg{width:22px;height:22px}

main{max-width:1320px;margin:0 auto;padding:10px 20px 50px;display:grid;grid-template-columns:minmax(0,1fr) 400px;gap:20px;align-items:start}
@media (max-width:1040px){main{grid-template-columns:minmax(0,1fr)}}
aside{position:sticky;top:16px}
@media (max-width:1040px){aside{position:static}}
.card{background:var(--glass);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border:1px solid var(--line);border-radius:20px;padding:18px;margin-bottom:20px;box-shadow:0 20px 50px rgba(0,0,0,.35),inset 0 1px 0 rgba(255,255,255,.05)}
.card h2{margin:0 0 14px;font:400 14px/1 "Russo One",Inter,sans-serif;letter-spacing:1.5px;text-transform:uppercase;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.card h2 .bolt{color:var(--y)}
.card h2 .sp{flex:1}
label.f{display:block;font-size:11px;font-weight:700;color:var(--mute);text-transform:uppercase;letter-spacing:.8px;margin-bottom:6px}
input,select,textarea{background:rgba(8,10,20,.6);border:1px solid var(--line2);color:var(--text);border-radius:12px;padding:10px 12px;font:inherit;width:100%;outline:none;transition:.15s}
select{cursor:pointer}
input:focus,select:focus,textarea:focus{border-color:var(--y);box-shadow:0 0 0 3px rgba(255,210,31,.18)}
select:disabled{opacity:.35;cursor:not-allowed}
.settings{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}
.settings .name{grid-column:1/-1}
@media (max-width:640px){.settings{grid-template-columns:1fr 1fr}}
.set{background:rgba(8,10,20,.35);border:1px solid var(--line);border-radius:14px;padding:10px}
.set.on{border-color:rgba(255,210,31,.45);box-shadow:inset 0 0 22px rgba(255,210,31,.07)}

button{font:inherit;cursor:pointer;color:var(--text)}
.btn{border:1px solid var(--line2);background:var(--glass2);border-radius:12px;padding:9px 14px;font-weight:700;transition:.15s}
.btn:hover{border-color:rgba(255,255,255,.3);transform:translateY(-1px)}
.btn.pri{background:linear-gradient(135deg,var(--y),var(--y2));color:#1b1200;border:0;box-shadow:0 8px 24px rgba(255,170,30,.35)}
.btn.pri:hover{box-shadow:0 10px 30px rgba(255,170,30,.55)}
.btn.danger:hover{border-color:var(--danger);color:var(--danger)}
.btn.sm{padding:7px 11px;font-size:12px}

/* preview */
.strip{display:flex;flex-wrap:wrap;gap:7px;align-items:center;min-height:46px;padding:12px;background:rgba(5,6,12,.55);border:1px solid var(--line);border-radius:14px}
.chip{display:inline-flex;align-items:center;gap:7px;padding:6px 10px;border-radius:10px;font-weight:800;font-size:12px;border:1px solid currentColor;background:color-mix(in srgb,currentColor 12%,transparent);box-shadow:0 0 14px color-mix(in srgb,currentColor 25%,transparent)}
.chip .k{font-family:var(--mono);background:rgba(0,0,0,.45);color:#fff;border-radius:6px;padding:1px 7px}
.chip small{font-size:10px;opacity:.85}
.arrow{color:var(--mute);font-weight:800}
.flag{font:800 11px var(--mono);padding:5px 9px;border-radius:8px;letter-spacing:.5px}
.flag.v3{background:rgba(255,210,31,.14);color:var(--y);border:1px solid rgba(255,210,31,.5)}
.flag.soru{background:rgba(63,182,255,.14);color:var(--sword);border:1px solid rgba(63,182,255,.5)}
.flag.m1{background:rgba(255,77,109,.14);color:#ff7b93;border:1px solid rgba(255,77,109,.5)}

/* steps */
.steps{display:flex;flex-direction:column;gap:10px}
.step{--wc:var(--melee);position:relative;background:linear-gradient(90deg,color-mix(in srgb,var(--wc) 10%,transparent),transparent 45%),var(--glass2);border:1px solid var(--line);border-radius:16px;padding:12px 12px 12px 16px;transition:border-color .15s,opacity .15s}
.step::before{content:"";position:absolute;left:0;top:10px;bottom:10px;width:4px;border-radius:4px;background:var(--wc);box-shadow:0 0 12px var(--wc)}
.step:hover{border-color:var(--line2)}
.step.off{opacity:.42}
.step.off::before{box-shadow:none;background:#555}
.step.drag{outline:2px dashed var(--y);outline-offset:2px}
.row{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.row + .row{margin-top:10px}
.handle{cursor:grab;color:var(--mute);user-select:none;font-size:15px;padding:2px 2px;letter-spacing:-2px}
.badge{width:30px;height:30px;border-radius:10px;display:grid;place-items:center;font:700 13px var(--mono);background:rgba(0,0,0,.4);border:1px solid var(--line2)}
.sw{position:relative;width:44px;height:24px;border-radius:20px;background:#2b3150;border:0;padding:0;flex:none;transition:.15s}
.sw::after{content:"";position:absolute;top:3px;left:3px;width:18px;height:18px;border-radius:50%;background:#c9cfe8;transition:.18s}
.sw.on{background:var(--ok);box-shadow:0 0 14px rgba(46,242,160,.5)}
.sw.on::after{left:23px;background:#fff}
.seg{display:inline-flex;background:rgba(5,6,12,.6);border:1px solid var(--line);border-radius:12px;padding:3px;gap:2px;flex-wrap:wrap}
.seg button{border:0;background:transparent;padding:6px 11px;border-radius:9px;font-size:12px;font-weight:800;color:var(--mute);transition:.12s}
.seg button:hover{color:var(--text)}
.seg button.on{color:#111;background:var(--c);box-shadow:0 0 14px color-mix(in srgb,var(--c) 55%,transparent)}
.sp{flex:1}
.keys{display:flex;gap:6px}
.key{width:38px;height:36px;border-radius:9px;border:1px solid var(--line2);border-bottom-width:4px;background:linear-gradient(#2a3050,#1b2036);font:700 15px var(--mono);color:#c9cfe8;transition:.08s}
.key:hover{color:#fff;border-color:rgba(255,255,255,.3)}
.key.on{background:linear-gradient(var(--y),var(--y2));color:#1b1200;border-color:#b06c00;transform:translateY(2px);border-bottom-width:2px;box-shadow:0 0 18px rgba(255,210,31,.55)}
.holdbox{display:inline-flex;align-items:center;gap:6px;width:104px}
.holdbox input{width:66px;padding:7px 8px;text-align:center;font-family:var(--mono)}
.holdbox span{color:var(--mute);font-size:12px}
.holdbox.hide{visibility:hidden}
.icon{width:32px;height:32px;border-radius:9px;border:1px solid var(--line);background:rgba(0,0,0,.25);color:var(--mute);font-size:14px;transition:.12s}
.icon:hover{color:#fff;border-color:var(--line2)}
.icon.danger:hover{color:var(--danger);border-color:var(--danger)}
.fbtn{border:1px dashed var(--line2);background:transparent;color:var(--mute);border-radius:10px;padding:7px 11px;font-size:12px;font-weight:800}
.fbtn:hover{color:var(--text)}
.fbtn.on{border-style:solid;border-color:rgba(182,107,255,.6);color:#d4b2ff;background:rgba(182,107,255,.12)}
.fallback{margin-top:10px;padding:10px 12px;border-radius:12px;background:rgba(182,107,255,.08);border:1px solid rgba(182,107,255,.3)}
.fallback .lbl{font-size:12px;font-weight:700;color:#d4b2ff}
.fallback select{width:auto;padding:7px 10px}

/* output */
pre{margin:0;background:rgba(3,4,9,.75);border:1px solid var(--line);border-radius:14px;padding:14px;max-height:360px;overflow:auto;font:12px/1.55 var(--mono);white-space:pre-wrap;word-break:break-all;color:#bcd6ff}
pre .s{color:#ffe27a}pre .n{color:#ff9fb2}pre .b{color:#8af5c6}
textarea{min-height:110px;font:12px/1.5 var(--mono);resize:vertical}
.actions{display:flex;gap:8px;margin-top:12px;flex-wrap:wrap}
.muted{color:var(--mute);font-size:12px}
.pill{font:700 11px var(--mono);color:var(--y);background:rgba(255,210,31,.1);border:1px solid rgba(255,210,31,.35);border-radius:20px;padding:4px 10px;letter-spacing:0;text-transform:none}
.err{color:var(--danger);font-size:12px;margin-top:6px;min-height:16px}
.toast{position:fixed;left:50%;bottom:26px;transform:translate(-50%,30px);opacity:0;background:linear-gradient(135deg,var(--y),var(--y2));color:#1b1200;padding:11px 18px;border-radius:14px;transition:.22s;pointer-events:none;font-weight:800;box-shadow:0 10px 30px rgba(255,170,30,.45)}
.toast.show{opacity:1;transform:translate(-50%,0)}
@media (max-width:560px){
  h1{font-size:24px}.discord{width:100%;justify-content:center}
  .key{width:34px}.card{padding:14px}
}
</style>
</head>
<body>
<div class="bg"></div>
<header>
  <svg class="logo" viewBox="0 0 64 64" aria-label="Pikachu">
    <path d="M14 30 L4 2 L26 20 Z" fill="#ffd21f" stroke="#1a1000" stroke-width="2" stroke-linejoin="round"/>
    <path d="M4 2 L9 16 L15 11 Z" fill="#1a1000"/>
    <path d="M50 30 L60 2 L38 20 Z" fill="#ffd21f" stroke="#1a1000" stroke-width="2" stroke-linejoin="round"/>
    <path d="M60 2 L55 16 L49 11 Z" fill="#1a1000"/>
    <ellipse cx="32" cy="39" rx="24" ry="20" fill="#ffd21f" stroke="#1a1000" stroke-width="2"/>
    <circle cx="23" cy="35" r="4" fill="#1a1000"/><circle cx="24.3" cy="33.6" r="1.4" fill="#fff"/>
    <circle cx="41" cy="35" r="4" fill="#1a1000"/><circle cx="42.3" cy="33.6" r="1.4" fill="#fff"/>
    <circle cx="15" cy="45" r="5" fill="#ff3b3b"/><circle cx="49" cy="45" r="5" fill="#ff3b3b"/>
    <path d="M31 40.5 l2 0 l-1 1.3 z" fill="#1a1000"/>
    <path d="M27 45 q2.5 3 5 0 q2.5 3 5 0" fill="none" stroke="#1a1000" stroke-width="1.6" stroke-linecap="round"/>
  </svg>
  <div class="brand">
    <h1>Cokeboys Macro Builder</h1>
    <p>Build your combo, copy the code, paste it into the macro.</p>
  </div>
  <a class="discord" href="https://discord.gg/cokeboys" target="_blank" rel="noopener">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.3 4.4A19.8 19.8 0 0 0 15.4 3l-.6 1.3a18.4 18.4 0 0 0-5.6 0L8.6 3a19.7 19.7 0 0 0-4.9 1.4C.6 9 -.3 13.6.1 18.1a19.9 19.9 0 0 0 6 3l1.3-2a12.9 12.9 0 0 1-2-1l.5-.4a14.2 14.2 0 0 0 12.2 0l.5.4c-.6.4-1.3.7-2 1l1.3 2a19.8 19.8 0 0 0 6-3c.5-5.2-.8-9.8-3.6-13.7ZM8.3 15.3c-1.2 0-2.2-1.1-2.2-2.4s1-2.4 2.2-2.4 2.2 1.1 2.2 2.4-1 2.4-2.2 2.4Zm7.4 0c-1.2 0-2.2-1.1-2.2-2.4s1-2.4 2.2-2.4 2.2 1.1 2.2 2.4-1 2.4-2.2 2.4Z"/></svg>
    Join our Discord
  </a>
</header>

<main>
  <section>
    <div class="card">
      <h2><span class="bolt">⚡</span>Macro</h2>
      <div class="settings">
        <div class="name"><label class="f">Name</label><input id="name" maxlength="40"></div>
        <div class="set" id="setV3"><label class="f">Race V3 after</label><select id="v3"></select></div>
        <div class="set" id="setSoru"><label class="f">Soru after</label><select id="soru"></select></div>
        <div class="set" id="setM1"><label class="f">M1 after</label><select id="m1"></select></div>
        <div class="set" id="setM1w"><label class="f">M1 weapon</label><select id="m1w"></select></div>
      </div>
    </div>

    <div class="card">
      <h2><span class="bolt">⚡</span>Combo preview</h2>
      <div class="strip" id="strip"></div>
    </div>

    <div class="card">
      <h2><span class="bolt">⚡</span>Steps <span class="pill" id="count"></span><span class="sp"></span>
        <button class="btn sm" id="allOn">All on</button>
        <button class="btn sm danger" id="reset">Reset all</button>
      </h2>
      <div class="steps" id="steps"></div>
      <p class="muted" style="margin:12px 0 0">10 slots. Drag ⋮⋮ to reorder. Switched-off steps are skipped. "Fallback" is the move used instead when this one is on cooldown.</p>
    </div>
  </section>

  <aside>
    <div class="card">
      <h2><span class="bolt">⚡</span>Macro code</h2>
      <pre id="out"></pre>
      <div class="actions">
        <button class="btn pri" id="copy">Copy code</button>
        <button class="btn" id="download">Download .json</button>
      </div>
    </div>
    <div class="card">
      <h2><span class="bolt">⚡</span>Import</h2>
      <textarea id="imp" placeholder='Paste a macro code here, e.g. {"name":"Slot 3", ...}'></textarea>
      <div class="err" id="err"></div>
      <div class="actions" style="margin-top:4px">
        <button class="btn pri" id="load">Load code</button>
        <button class="btn" id="openFile">Open file…</button>
        <input type="file" id="file" accept=".json,.txt,application/json" hidden>
      </div>
    </div>
  </aside>
</main>
<div class="toast" id="toast"></div>

<script>
const WEAPONS = {Fruit:'--fruit', Melee:'--melee', Sword:'--sword', Gun:'--gun'};
const KEYS = ['Z','X','C','V','F'];
const FORMAT = 'cokeboys-smart-macro';
const SLOTS = 10;
const STEP_KEYS = ['enabled','fallback','hold','mode','skill','weapon'];
const blankStep = () => ({raw:{},enabled:true,skill:'Z',weapon:'Melee',mode:'Tap',hold:'1',fallback:null});
const BLANK = {name:'My macro',steps:Array.from({length:SLOTS},()=>({skill:'Z',weapon:'Melee'})),format:FORMAT,version:10};
const $ = id => document.getElementById(id);
const wc = w => `var(${WEAPONS[w]||'--mute'})`;
const esc = s => String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
let M;

function fromJSON(o){
  if(!o || typeof o!=='object' || !Array.isArray(o.steps)) throw new Error('This code has no "steps" list.');
  const known = new Set(['name','v3','steps','format','m1','version','soru']);
  const extra = {}; for(const k in o) if(!known.has(k)) extra[k]=o[k];
  const steps = o.steps.slice(0,SLOTS).map(s=>({
    raw: Object.fromEntries(Object.entries(s).filter(([k])=>!STEP_KEYS.includes(k))),
    enabled: s.enabled !== false,
    skill: String(s.skill||'Z').toUpperCase(),
    weapon: s.weapon || 'Melee',
    mode: s.mode === 'Hold' ? 'Hold' : 'Tap',
    hold: s.hold != null ? String(s.hold) : '1',
    fallback: s.fallback && typeof s.fallback==='object' ? {...s.fallback, skill:String(s.fallback.skill||'Z').toUpperCase(), weapon:s.fallback.weapon||'Melee'} : null
  }));
  while(steps.length<SLOTS) steps.push({...blankStep(),enabled:false});
  return {
    name: String(o.name ?? 'My macro'),
    v3: o.v3 && o.v3.after!=null ? {...o.v3} : null,
    soru: o.soru && o.soru.after!=null ? {...o.soru} : null,
    m1: o.m1 && o.m1.after!=null ? {...o.m1, weapon:o.m1.weapon||'Melee'} : null,
    m1Weapon: (o.m1 && o.m1.weapon) || 'Melee',
    version: o.version ?? 10, extra, steps
  };
}
function toJSON(){
  const o = {name:M.name};
  if(M.v3) o.v3 = M.v3;
  o.steps = M.steps.map(s=>{
    const r = {};
    if(!s.enabled) r.enabled = false;
    if(s.fallback){ const {skill,weapon,...rest}=s.fallback; r.fallback = {skill,weapon,...rest}; }
    if(s.mode==='Hold'){ r.hold = s.hold || '1'; r.mode = 'Hold'; }
    r.skill = s.skill; r.weapon = s.weapon;
    return Object.assign(r, s.raw);
  });
  o.format = FORMAT;
  if(M.m1){ const {after,weapon,...rest}=M.m1; o.m1 = {after,weapon,...rest}; }
  o.version = M.version;
  if(M.soru) o.soru = M.soru;
  return Object.assign(o, M.extra);
}
const code = () => JSON.stringify(toJSON());

function afterOptions(sel, cur){
  sel.innerHTML = '<option value="">Off</option>' + Array.from({length:SLOTS},(_,i)=>`<option value="${i+1}">After step ${i+1}</option>`).join('');
  sel.value = cur==null ? '' : String(cur);
  if(cur!=null && sel.value!==String(cur)){ sel.insertAdjacentHTML('beforeend',`<option value="${esc(cur)}">After step ${esc(cur)}</option>`); sel.value=String(cur); }
}
function render(){
  $('name').value = M.name;
  afterOptions($('v3'), M.v3?.after); afterOptions($('soru'), M.soru?.after); afterOptions($('m1'), M.m1?.after);
  $('m1w').innerHTML = Object.keys(WEAPONS).map(w=>`<option>${w}</option>`).join('');
  $('m1w').value = M.m1 ? M.m1.weapon : M.m1Weapon;
  renderSteps(); renderOut();
}
function renderOut(){
  $('setV3').classList.toggle('on',!!M.v3); $('setSoru').classList.toggle('on',!!M.soru);
  $('setM1').classList.toggle('on',!!M.m1); $('setM1w').classList.toggle('on',!!M.m1); $('m1w').disabled = !M.m1;
  const pretty = JSON.stringify(toJSON(), null, 1)
    .replace(/\n\s*(?=[}\]])/g,'').replace(/\{\n\s+/g,'{').replace(/,\n\s+(?="(skill|weapon|mode|hold|enabled|fallback|after)")/g,', ');
  $('out').innerHTML = esc(pretty)
    .replace(/(&quot;[^&]*?&quot;)(?=:)/g,'<span>$1</span>')
    .replace(/: (&quot;.*?&quot;)/g,': <span class="s">$1</span>')
    .replace(/: (\d+)/g,': <span class="n">$1</span>')
    .replace(/: (true|false)/g,': <span class="b">$1</span>');
  const on = M.steps.filter(s=>s.enabled).length;
  $('count').textContent = `${on} / ${SLOTS} active`;
  const st = $('strip'); st.innerHTML=''; let any=false;
  M.steps.forEach((s,i)=>{
    if(s.enabled){
      if(any) st.insertAdjacentHTML('beforeend','<span class="arrow">›</span>');
      any=true;
      st.insertAdjacentHTML('beforeend',`<span class="chip" style="color:${wc(s.weapon)}">${s.weapon} <span class="k">${s.skill}</span>${s.mode==='Hold'?`<small>hold ${esc(s.hold)}s</small>`:''}${s.fallback?`<small>or ${s.fallback.weapon} ${s.fallback.skill}</small>`:''}</span>`);
    }
    if(M.v3?.after==i+1) st.insertAdjacentHTML('beforeend','<span class="flag v3">V3</span>');
    if(M.m1?.after==i+1) st.insertAdjacentHTML('beforeend',`<span class="flag m1">M1 · ${esc(M.m1.weapon)}</span>`);
    if(M.soru?.after==i+1) st.insertAdjacentHTML('beforeend','<span class="flag soru">SORU</span>');
  });
  if(!any) st.innerHTML='<span class="muted">No active steps yet.</span>';
}

let dragFrom=null;
function weaponSeg(cur, act){ return `<div class="seg">${Object.keys(WEAPONS).map(w=>`<button data-a="${act}" data-v="${w}" class="${cur===w?'on':''}" style="--c:${wc(w)}">${w}</button>`).join('')}</div>`; }
function renderSteps(){
  const box=$('steps'); box.innerHTML='';
  M.steps.forEach((s,i)=>{
    const el=document.createElement('div');
    el.className='step'+(s.enabled?'':' off');
    el.style.setProperty('--wc', wc(s.weapon));
    el.innerHTML=`
      <div class="row">
        <span class="handle" draggable="true" title="Drag to reorder">⋮⋮</span>
        <span class="badge">${i+1}</span>
        <button class="sw ${s.enabled?'on':''}" data-a="tog" title="On / off"></button>
        ${weaponSeg(s.weapon,'w')}
        <span class="sp"></span>
        <button class="icon" data-a="up" title="Move up">↑</button>
        <button class="icon" data-a="down" title="Move down">↓</button>
        <button class="icon danger" data-a="clr" title="Reset this step">↺</button>
      </div>
      <div class="row">
        <div class="keys">${KEYS.map(k=>`<button class="key ${s.skill===k?'on':''}" data-a="k" data-v="${k}">${k}</button>`).join('')}</div>
        <div class="seg"><button data-a="m" data-v="Tap" class="${s.mode==='Tap'?'on':''}" style="--c:#dfe4ff">Tap</button><button data-a="m" data-v="Hold" class="${s.mode==='Hold'?'on':''}" style="--c:var(--y)">Hold</button></div>
        <div class="holdbox ${s.mode==='Hold'?'':'hide'}"><input data-h type="number" min="0" step="0.1" value="${esc(s.hold)}" title="Hold time"><span>sec</span></div>
        <span class="sp"></span>
        <button class="fbtn ${s.fallback?'on':''}" data-a="fb">${s.fallback?'✓ Fallback':'+ Fallback'}</button>
      </div>
      ${s.fallback?`<div class="fallback row"><span class="lbl">If on cooldown, use</span>${weaponSeg(s.fallback.weapon,'fw')}<div class="keys">${KEYS.map(k=>`<button class="key ${s.fallback.skill===k?'on':''}" data-a="fk" data-v="${k}">${k}</button>`).join('')}</div></div>`:''}`;
    el.addEventListener('click',e=>{
      const b=e.target.closest('[data-a]'); if(!b) return;
      const a=b.dataset.a, v=b.dataset.v;
      if(a==='tog') s.enabled=!s.enabled;
      else if(a==='w') s.weapon=v;
      else if(a==='k') s.skill=v;
      else if(a==='m') s.mode=v;
      else if(a==='fb') s.fallback = s.fallback ? null : {skill:'X',weapon:s.weapon};
      else if(a==='fw') s.fallback.weapon=v;
      else if(a==='fk') s.fallback.skill=v;
      else if(a==='up' && i>0) [M.steps[i-1],M.steps[i]]=[M.steps[i],M.steps[i-1]];
      else if(a==='down' && i<SLOTS-1) [M.steps[i+1],M.steps[i]]=[M.steps[i],M.steps[i+1]];
      else if(a==='clr') M.steps[i]=blankStep();
      else return;
      renderSteps(); renderOut();
    });
    const h=el.querySelector('[data-h]');
    h.addEventListener('input',()=>{ s.hold=h.value; renderOut(); });
    const hd=el.querySelector('.handle');
    hd.addEventListener('dragstart',e=>{dragFrom=i; e.dataTransfer.effectAllowed='move'; e.dataTransfer.setData('text/plain',String(i));});
    hd.addEventListener('dragend',()=>dragFrom=null);
    el.addEventListener('dragover',e=>{ if(dragFrom==null) return; e.preventDefault(); el.classList.add('drag'); });
    el.addEventListener('dragleave',()=>el.classList.remove('drag'));
    el.addEventListener('drop',e=>{ e.preventDefault(); el.classList.remove('drag');
      if(dragFrom==null||dragFrom===i) return;
      const [m]=M.steps.splice(dragFrom,1); M.steps.splice(i,0,m); dragFrom=null; render(); });
    box.appendChild(el);
  });
}

function toast(t){ const el=$('toast'); el.textContent=t; el.classList.add('show'); clearTimeout(el._t); el._t=setTimeout(()=>el.classList.remove('show'),1600); }
function load(o,msg){ M=fromJSON(o); render(); if(msg) toast(msg); }

$('name').addEventListener('input',e=>{M.name=e.target.value; renderOut();});
$('v3').addEventListener('change',e=>{M.v3 = e.target.value?{...(M.v3||{}),after:Number(e.target.value)}:null; renderOut();});
$('soru').addEventListener('change',e=>{M.soru = e.target.value?{...(M.soru||{}),after:Number(e.target.value)}:null; renderOut();});
$('m1').addEventListener('change',e=>{M.m1 = e.target.value?{...(M.m1||{weapon:$('m1w').value}),after:Number(e.target.value)}:null; renderOut();});
$('m1w').addEventListener('change',e=>{M.m1Weapon=e.target.value; if(M.m1) M.m1.weapon=e.target.value; renderOut();});
$('allOn').onclick=()=>{ M.steps.forEach(s=>s.enabled=true); render(); };
$('reset').onclick=()=>{ if(confirm('Reset every step to Z and turn V3 / Soru / M1 off?')) load(BLANK,'Reset'); };

async function copyText(t){
  try{ await navigator.clipboard.writeText(t); }
  catch(e){ const ta=document.createElement('textarea'); ta.value=t; document.body.appendChild(ta); ta.select(); document.execCommand('copy'); ta.remove(); }
}
$('copy').onclick=async()=>{ await copyText(code()); toast('Copied! Paste it into the macro ⚡'); };
$('download').onclick=()=>{
  const a=document.createElement('a'); a.href=URL.createObjectURL(new Blob([code()],{type:'application/json'}));
  a.download=(M.name||'macro').replace(/[^\w\- ]+/g,'_')+'.json'; a.click(); setTimeout(()=>URL.revokeObjectURL(a.href),1000);
};
$('load').onclick=()=>{
  $('err').textContent='';
  try{ load(JSON.parse($('imp').value.trim()),'Loaded'); $('imp').value=''; }
  catch(e){ $('err').textContent = e instanceof SyntaxError ? 'That is not valid macro code. Copy the whole thing, from { to }.' : e.message; }
};
$('openFile').onclick=()=>$('file').click();
$('file').onchange=async e=>{ const f=e.target.files[0]; if(!f) return; $('imp').value=await f.text(); $('load').click(); e.target.value=''; };

load(BLANK);
</script>
</body>
</html>
